# Festayre, variables d'environnement.
# Copier vers .env.local (jamais commite) et remplir.
# EN: in local dev, next.config.ts and scripts/load-env.mjs also load the
# central secrets file ~/.secrets/projets.env (or CENTRAL_ENV_FILE) without
# overriding variables already set. Shared keys carry the FESTAYRE prefix.
# FR : en local, next.config.ts et scripts/load-env.mjs chargent aussi le
# fichier central ~/.secrets/projets.env (ou CENTRAL_ENV_FILE) sans ecraser
# les variables deja definies. Les cles partagees portent le prefixe FESTAYRE.
# SANS ces variables l'app tourne quand meme en mode invite
# (carte, toilettes, programme) : seuls compte et Festayre+ sont off.

# --- Supabase (comptes + favoris) ------------------------------------
# Dashboard > Settings > API
NEXT_PUBLIC_FESTAYRE_SUPABASE_URL=
NEXT_PUBLIC_FESTAYRE_SUPABASE_ANON_KEY=
# Cle ADMIN, serveur uniquement (webhook Stripe). Ne jamais prefixer
# par NEXT_PUBLIC_, ne jamais exposer au navigateur.
FESTAYRE_SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (pack Festayre+) ------------------------------------------
# Dashboard > Developers > API keys
FESTAYRE_STRIPE_SECRET_KEY=
# Price ID du produit "Festayre+" (paiement unique), ex : price_xxx
STRIPE_PRICE_FESTAYRE_PLUS=
# Dashboard > Developers > Webhooks > endpoint /api/stripe/webhook
FESTAYRE_STRIPE_WEBHOOK_SECRET=

# --- PostHog (analytics produit, host UE) ------------------------------
# https://eu.posthog.com > Settings > Project > Project API key
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Sentry (monitoring erreurs) ---------------------------------------
# https://sentry.io > Settings > Projects > [projet] > Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=
